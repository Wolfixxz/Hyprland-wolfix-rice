{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "$(find \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/ascii/\" -name \"*.txt\" | shuf -n 1)",
    "color": {
      "1": "red",
      "2": "red",
      "3": "red",
      "4": "red",
      "5": "red",
      "6": "red",
      "7": "red",
      "8": "red",
      "9": "red"
    }
  },
  "display": {
    "separator": " : ",
  },
  "modules": [
    {
      "type": "command",
      "key": "  ",
      "keyColor": "red",
      "text": "echo 'System'",
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────┐",
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{2}",
      "keyColor": "red",
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{2}",
      "keyColor": "red",
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages",
      "keyColor": "red",
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "red",
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "red",
    },
    {
      "type": "wm",
      "key": "  󱗃 WM",
      "format": "{2}",
      "keyColor": "red",
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "title",
      "key": "  ",
      "keyColor": "red",
      "format": "{6} {7} {8}",
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────┐",
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "   CPU",
      "keyColor": "red",
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  󰊴 GPU",
      "keyColor": "red",
    },
    {
      "type": "memory",
      "key": "  💾Memory ",
      "keyColor": "red",
    },
    {
      "type": "command",
      "key": "  󱦟 OS Age ",
      "keyColor": "red",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime ",
      "keyColor": "red",
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────┘",
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
    "break",
  ],
}
